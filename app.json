{
  "expo": {
    "name": "Планировщик",
    "slug": "planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "planner",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111316",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Распознавание речи нужно, чтобы превратить голос в текст задачи",
        "NSMicrophoneUsageDescription": "Микрофон нужен, чтобы надиктовать задачу"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zeroner00.planner",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111316",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы записать задачу фотографией",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото нужен, чтобы прикрепить снимок к задаче"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Микрофон нужен, чтобы надиктовать задачу",
          "speechRecognitionPermission": "Распознавание речи нужно, чтобы превратить голос в текст задачи",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "76a3e17b-8ad3-46e3-ab9a-875fbc2c654f"
      }
    },
    "owner": "zeroner"
  }
}
